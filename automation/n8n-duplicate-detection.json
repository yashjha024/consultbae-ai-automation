        "jsonBody": "={\"name\":\"\",\"phone\":\"{{ $json.normalized_phone }}\",\"email\":\"{{ $json.normalized_email }}\"}",
        "options": {}
      },
      "id": "lookup",
      "name": "Check canonical person via API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 300],
