{
  "name": "ConsultBae Duplicate Detection",
  "nodes": [
    {
      "parameters": {
        "path": "consultbae-duplicate-check",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "1",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        250,
        300
      ],
      "webhookId": "cb-dup-check-1234"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, canonical_name FROM persons WHERE normalized_phone = '{{ $json.body.phone }}' OR normalized_email = '{{ $json.body.email }}' LIMIT 1"
      },
      "id": "2",
      "name": "Check Duplicate in SQLite",
      "type": "n8n-nodes-base.sqlite",
      "typeVersion": 1,
      "position": [
        450,
        300
      ],
      "credentials": {
        "sqlite": {
          "id": "1",
          "name": "SQLite account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.id }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "3",
      "name": "Is Duplicate?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        650,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://webhook.site/duplicate-alert",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "text",
              "value": "=Duplicate detected for {{ $('Webhook').item.json.body.name }}. Matches existing person ID {{ $json.id }} ({{ $json.canonical_name }})."
            }
          ]
        },
        "options": {}
      },
      "id": "4",
      "name": "Send Alert (Slack/Webhook)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 3,
      "position": [
        850,
        200
      ]
    },
    {
      "parameters": {},
      "id": "5",
      "name": "No Action (New Record)",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        850,
        400
      ]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Check Duplicate in SQLite",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Duplicate in SQLite": {
      "main": [
        [
          {
            "node": "Is Duplicate?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Duplicate?": {
      "main": [
        [
          {
            "node": "Send Alert (Slack/Webhook)",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "No Action (New Record)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "meta": {
    "templateId": "1"
  }
}
