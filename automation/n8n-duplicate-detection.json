              "type": "string"
            },
            {
              "id": "phone",
              "name": "normalized_phone",
              "value": "={{ (() => { const digits = ($json.body.phone || '').replace(/\\D/g, ''); const local = digits.length === 11 && digits.startsWith('0') ? digits.slice(1) : (digits.length === 12 && digits.startsWith('91') ? digits.slice(2) : digits); return /^[6-9]\\d{9}$/.test(local) ? '+91' + local : ''; })() }}",
              "type": "string"
            },
            {
              "id": "name",
              "name": "submitted_name",
              "value": "={{ $json.body.name || '' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "normalize",
      "name": "Normalize identity keys",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [440, 300]
